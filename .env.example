# Copy to `apps/backend/.env` (runtime) and `packages/db/.env` (drizzle-kit CLI).
# `packages/db/drizzle.config.ts` also falls back to a root `.env`.

# PostgreSQL connection string used by @repo/db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/system_management_edc

# Secret used to sign session cookies — generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Base URL the backend (auth server) is reachable at
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated list of origins allowed to send credentialed requests (Web, Expo, Emulators, LAN IP)
# In development, localhost, 127.0.0.1, 10.0.2.2, and current LAN IPv4 are automatically added.
TRUSTED_ORIGINS=http://localhost:5173,http://192.168.1.10:5173,exp://192.168.1.10:8081

# Public origin of the web console; auth emails (verification / password reset)
# redirect here after their action completes. Must be listed in TRUSTED_ORIGINS.
WEB_APP_URL=http://localhost:5173

# Backend HTTP port
PORT=3001

# First System Administrator account, created by: pnpm --filter backend seed:admin
# (sign-up is disabled, so the initial sysAdmin must be seeded out-of-band)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=System Administrator

# LDAP directory for AD-style logins (POST /api/auth/sign-in/credentials).
# Defaults target the public read-only Forum Systems test server; every test
# user (einstein, newton, tesla, gauss, euler, ...) has the password "password".
# Point these at your real directory (use ldaps://) in production.
LDAP_URL=ldap://ldap.forumsys.com:389
LDAP_BIND_DN=cn=read-only-admin,dc=example,dc=com
LDAP_BIND_PASSWORD=password
LDAP_SEARCH_BASE=dc=example,dc=com
# Attribute matched against the local part of the login email
# (use sAMAccountName or userPrincipalName for a real Active Directory)
LDAP_USERNAME_ATTRIBUTE=uid
# Comma-separated email domains that authenticate via LDAP instead of email & password
LDAP_EMAIL_DOMAINS=ldap.forumsys.com

# ─── Mobile App Update Configuration ────────────────────────────────────────
# OTA (Expo Over-The-Air) update settings
# The EAS/Expo OTA release channel to serve updates from (e.g. production, preview, staging)
MOBILE_OTA_CHANNEL=production
# The Expo runtime version clients must have to receive OTA updates
MOBILE_OTA_RUNTIME_VERSION=1.0.0

# APK standalone download settings
# Direct public download URL for the release APK binary
MOBILE_APK_DOWNLOAD_URL=https://example.com/downloads/app-release.apk

# Mobile client endpoint configuration (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_CHECK_UPDATE_ENDPOINT=api/mobile/version
