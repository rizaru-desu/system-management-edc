# Base URL of the NestJS backend that mounts Better Auth (/api/auth/*).
VITE_API_URL=http://localhost:3001

# Mirror of the backend's LDAP_EMAIL_DOMAINS: emails on these domains sign in
# via POST /api/auth/sign-in/credentials (LDAP) instead of sign-in/email.
VITE_LDAP_EMAIL_DOMAINS=ldap.forumsys.com
