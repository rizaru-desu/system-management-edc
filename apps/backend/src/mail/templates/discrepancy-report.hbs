<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Laporan Perbedaan Penerimaan</title>
  </head>
  <body style="margin:0;padding:0;background-color:#f6f7f9;">
    <!-- Preheader: inbox preview text, invisible in the opened email. -->
    <span style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
      Laporan perbedaan hasil inspeksi penerimaan untuk Surat Jalan {{doNumber}}.
    </span>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f7f9;">
      <tr>
        <td align="center" style="padding:40px 16px;">
          <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="width:640px;max-width:100%;">
            <tr>
              <td style="background-color:#ffffff;border:1px solid #dde0ec;border-radius:16px;padding:36px 40px;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    <td width="40" height="40" style="width:40px;height:40px;background-color:#3f6fa8;border-radius:12px;text-align:center;vertical-align:middle;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;font-weight:800;color:#f6f7f9;">E</td>
                    <td style="padding-left:12px;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                      <p style="margin:0;font-size:15px;font-weight:800;color:#0e2748;">EDC Management</p>
                      <p style="margin:0;font-size:12px;font-weight:500;color:#8593ad;">System Console</p>
                    </td>
                  </tr>
                </table>

                <p style="margin:30px 0 10px;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#b45309;">Laporan perbedaan penerimaan</p>
                <h1 style="margin:0 0 14px;font-size:23px;line-height:1.25;font-weight:800;color:#0e2748;">Surat Jalan {{doNumber}}</h1>

                <p style="margin:0 0 12px;font-size:14px;line-height:1.65;color:#47618b;">Kepada Yth. <strong style="color:#0e2748;">{{partnerName}}</strong>{{#if picName}} (u.p. {{picName}}){{/if}},</p>
                <p style="margin:0 0 12px;font-size:14px;line-height:1.65;color:#47618b;">
                  Inspeksi penerimaan atas Surat Jalan <strong style="color:#0e2748;">{{doNumber}}</strong>
                  di gudang <strong style="color:#0e2748;">{{warehouseName}}</strong>
                  (diterima {{receivedDate}}) menemukan perbedaan berikut antara dokumen
                  pengiriman dan barang yang kami terima secara fisik.
                </p>
                {{#if message}}
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 16px;">
                  <tr>
                    <td style="background-color:#edeff6;border:1px solid #dde0ec;border-radius:12px;padding:12px 16px;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#47618b;">{{message}}</td>
                  </tr>
                </table>
                {{/if}}

                {{#if hasMissing}}
                <p style="margin:22px 0 8px;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#b91c1c;">Unit tidak diterima ({{missingCount}})</p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #dde0ec;border-radius:10px;border-collapse:separate;overflow:hidden;">
                  <tr style="background-color:#f6f7f9;">
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Serial number</td>
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Model</td>
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Catatan</td>
                  </tr>
                  {{#each missingUnits}}
                  <tr>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;font-weight:700;color:#0e2748;font-family:'Courier New',monospace;">{{this.serialNumber}}</td>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;color:#47618b;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.product}}</td>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;color:#47618b;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.notes}}</td>
                  </tr>
                  {{/each}}
                </table>
                {{/if}}

                {{#if hasDamaged}}
                <p style="margin:22px 0 8px;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#b45309;">Unit rusak ({{damagedCount}})</p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #dde0ec;border-radius:10px;border-collapse:separate;overflow:hidden;">
                  <tr style="background-color:#f6f7f9;">
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Serial number</td>
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Model</td>
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Catatan</td>
                  </tr>
                  {{#each damagedUnits}}
                  <tr>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;font-weight:700;color:#0e2748;font-family:'Courier New',monospace;">{{this.serialNumber}}</td>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;color:#47618b;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.product}}</td>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;color:#47618b;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.notes}}</td>
                  </tr>
                  {{/each}}
                </table>
                {{/if}}

                {{#if hasIncomplete}}
                <p style="margin:22px 0 8px;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#b45309;">Unit tidak lengkap ({{incompleteCount}})</p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #dde0ec;border-radius:10px;border-collapse:separate;overflow:hidden;">
                  <tr style="background-color:#f6f7f9;">
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Serial number</td>
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Model</td>
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Kelengkapan kurang</td>
                  </tr>
                  {{#each incompleteUnits}}
                  <tr>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;font-weight:700;color:#0e2748;font-family:'Courier New',monospace;">{{this.serialNumber}}</td>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;color:#47618b;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.product}}</td>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;color:#47618b;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.missingAccessories}}</td>
                  </tr>
                  {{/each}}
                </table>
                {{/if}}

                {{#if hasUnlisted}}
                <p style="margin:22px 0 8px;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#3f6fa8;">Unit di luar dokumen ({{unlistedCount}})</p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #dde0ec;border-radius:10px;border-collapse:separate;overflow:hidden;">
                  <tr style="background-color:#f6f7f9;">
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Serial number</td>
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Model</td>
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Catatan</td>
                  </tr>
                  {{#each unlistedUnits}}
                  <tr>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;font-weight:700;color:#0e2748;font-family:'Courier New',monospace;">{{this.serialNumber}}</td>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;color:#47618b;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.product}}</td>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;color:#47618b;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.notes}}</td>
                  </tr>
                  {{/each}}
                </table>
                {{/if}}

                {{#if hasVariances}}
                <p style="margin:22px 0 8px;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#b45309;">Selisih jumlah aksesori ({{varianceCount}})</p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #dde0ec;border-radius:10px;border-collapse:separate;overflow:hidden;">
                  <tr style="background-color:#f6f7f9;">
                    <td style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Item</td>
                    <td align="right" style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Dokumen</td>
                    <td align="right" style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Diterima</td>
                    <td align="right" style="padding:8px 12px;font-size:11px;font-weight:700;color:#8593ad;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Selisih</td>
                  </tr>
                  {{#each variances}}
                  <tr>
                    <td style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;font-weight:700;color:#0e2748;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.itemName}}</td>
                    <td align="right" style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;color:#47618b;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.documentedQty}} {{this.unit}}</td>
                    <td align="right" style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;color:#47618b;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.receivedQty}} {{this.unit}}</td>
                    <td align="right" style="padding:8px 12px;border-top:1px solid #dde0ec;font-size:12px;font-weight:700;color:#b91c1c;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">{{this.variance}}</td>
                  </tr>
                  {{/each}}
                </table>
                {{/if}}

                <p style="margin:26px 0 0;font-size:14px;line-height:1.65;color:#47618b;">
                  Mohon konfirmasi atas perbedaan di atas — apakah kekurangan akan
                  dikirimkan menyusul, atau penerimaan dianggap sesuai kondisi
                  aktual. Terima kasih.
                </p>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:24px 8px 0;font-family:'Manrope','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                <p style="margin:0 0 4px;font-size:12px;font-weight:600;color:#8593ad;">EDC Management &middot; System Console</p>
                <p style="margin:0;font-size:12px;color:#a5b0c6;">Email otomatis dari sistem &mdash; mohon tidak membalas email ini.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
