# ==============================================================================
# Mobile App Environment Configuration
# ==============================================================================
# Note: In development (__DEV__), the app automatically detects your Metro bundler host IP
# at runtime via expo-constants (e.g. http://<metro-host>:3001), working seamlessly across:
# - Physical devices over Wi-Fi / LAN (no manual IP changes needed!)
# - Android Emulator (auto-mapped to 10.0.2.2:3001)
# - iOS Simulator (auto-mapped to localhost:3001)
#
# In production (or to manually override auto-detection), set EXPO_PUBLIC_API_URL:
EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional: Override backend port if not using default 3001
# EXPO_PUBLIC_API_PORT=3001

# Mobile check-update endpoint path
EXPO_PUBLIC_CHECK_UPDATE_ENDPOINT=api/mobile/version

